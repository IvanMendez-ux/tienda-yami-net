<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@100;300;400;700;900&display=swap" rel="stylesheet">
    <title>@ViewData["Title"] - tienda_yami</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark position-absolute w-100 navbar-transparent"
            style="z-index: 10; top: 0;">
            <div class="container-fluid">
                <img src="~/img/icons/@(ViewData["Logo"] ?? "logo-light.jpeg")" style="height: 150px; width: auto;" />
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-ligth header-text" asp-area="" asp-controller="Home"
                                asp-action="Index">MUJER</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-ligth header-text" asp-area="" asp-controller="Home"
                                asp-action="Privacy">HOMBRE</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="p-0 m-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container">
            <div class="row">
                <div class="col-4">
                    <img src="~/img/icons/logo-light.jpeg" style="height: 150px; width:150px" />
                </div>
                <div class="col-4">
                    <h4 class="footer-title">FORMAS DE PAGO</h4>
                    <ul class=list>
                        <li class=listItem>
                            <i class="bi bi-qr-code"></i> QR
                        </li>
                        <li class=listItem>
                            <i class="bi bi-cash-stack"></i> Efectivo contra entrega
                        </li>
                        <li class=listItem>
                            <i class="bi bi-bank"></i> Transferencia bancaria
                        </li>
                    </ul>
                </div>
                <div class="col-4">
                    <h4 class="footer-title">CONTACTANOS</h4>
                    <ul class=list>
                        <li class="listItem">
                            <a href="https://www.facebook.com/share/1CHoNivKMU/?mibextid=wwXIfr" target="_blank"
                                rel="noopener noreferrer">
                                <i class="bi bi-facebook"></i> Facebook
                            </a>
                        </li>
                        <li class=listItem>
                            <a href="https://www.instagram.com/tienda_yamipy?igsh=MTA2bTNtY2k0bjl4dw==" target="_blank"
                                rel="noopener noreferrer">
                                <i class="bi bi-instagram"></i> Instagram
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>